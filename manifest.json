{
  "manifest_version": 3,
  "name": "Accessible Date Picker",
  "short_name": "Date Picker",
  "version": "1.0.0",
  "description": "Set dates in stubborn website calendars with a keyboard and screen reader.",
  "minimum_chrome_version": "102",
  "action": {
    "default_title": "Accessible Date Picker: set the date for the focused field",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "commands": {
    "open-date-picker": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Open the accessible date picker for the focused field"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
