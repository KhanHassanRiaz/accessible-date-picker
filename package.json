{
  "name": "accessible-date-picker",
  "version": "1.0.0",
  "private": true,
  "description": "A keyboard-first date picker helper for inaccessible web calendars.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "build:test": "node scripts/build.mjs --test",
    "icons": "node scripts/make-icons.mjs",
    "package": "node scripts/package.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:e2e": "npm run build:test && playwright test",
    "test": "npm run lint && npm run test:unit && npm run test:e2e",
    "serve:fixtures": "node tests/fixtures/server.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.51.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.13.10",
    "archiver": "^7.0.1",
    "bootstrap-datepicker": "1.10.0",
    "esbuild": "^0.25.1",
    "eslint": "^9.22.0",
    "flatpickr": "4.6.13",
    "jquery": "3.7.1",
    "jquery-ui": "1.14.1",
    "jsdom": "^26.0.0",
    "pikaday": "1.8.2",
    "pngjs": "^7.0.0",
    "prettier": "^3.5.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.8"
  }
}
